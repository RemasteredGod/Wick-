{
  "name": "wick",
  "version": "0.1.0",
  "description": "Chrome extension that tracks Claude.ai usage limits and projects when you will run out",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm icons:generate && tsc --noEmit && vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-extension-build.mjs",
    "package": "node scripts/package-extension.mjs",
    "verify:package": "node scripts/verify-extension-package.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
