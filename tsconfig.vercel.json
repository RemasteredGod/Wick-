{
  // The deploy's typecheck.
  //
  // The root config covers the Chrome extension too. Vercel builds `api/` and
  // the two pure modules it imports; this checks exactly that and nothing else.
  // Vercel's native function transpiler still reads the root config and runs a
  // separate install, so the repository `.npmrc` keeps the required ambient
  // declarations installed even when NODE_ENV is production.
  //
  // Vercel compiles the functions themselves with esbuild, which does not
  // typecheck. So this is the only thing standing between a type error and
  // production.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The explicit deployment typecheck needs Node declarations because the
    // handlers read `process.env`; extension-only ambient types stay excluded.
    "types": ["node"],
    // The extension's surfaces are the only JSX in the project, and none of it
    // is here.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["api", "server", "leaderboard"]
}
